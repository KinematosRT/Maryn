FROM node:22-slim AS builder

WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src/ src/
RUN npm run build

FROM node:22-slim AS deps

WORKDIR /deps
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM gcr.io/distroless/nodejs22-debian12:nonroot

USER 65532:65532
WORKDIR /app

COPY --chown=65532:65532 --from=builder /build/package.json /app/
COPY --chown=65532:65532 --from=deps /deps/node_modules /app/node_modules
COPY --chown=65532:65532 --from=builder /build/dist /app/dist
COPY --chown=65532:65532 context-template /app/context-template

CMD ["dist/index.js"]
